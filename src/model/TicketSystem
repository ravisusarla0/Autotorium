package model;

import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class TicketSystem {
    private int ticketId;
    private GarageBuild build;
    private String customerName;
    private String status; // "PENDING", "IN_PROGRESS", "COMPLETED"
    private String createdAt;

    public TicketSystem(int ticketId, GarageBuild build, String customerName) {
        this.ticketId = ticketId;
        this.build = build;
        this.customerName = customerName;
        this.status = "PENDING";
        this.createdAt = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm"));
    }

    public int getTicketId() { return ticketId; }
    public GarageBuild getBuild() { return build; }
    public String getCustomerName() { return customerName; }
    public String getStatus() { return status; }
    public void setStatus(String status) { this.status = status; }
    public String getCreatedAt() { return createdAt; }

    // Formats the full modification spec sheet for the builders/mechanics
    public String generateWorkOrderSpec() {
        StringBuilder sb = new StringBuilder();
        sb.append("========================================\n");
        sb.append("WORK ORDER TICKET #").append(ticketId).append(" [").append(status).append("]\n");
        sb.append("Submitted: ").append(createdAt).append("\n");
        sb.append("Customer:  ").append(customerName).append("\n");
        sb.append("Build:     ").append(build.getBuildName()).append("\n");
        sb.append("Base Car:  ").append(build.getVehicle().getName())
          .append(" (").append(build.getVehicle().getType()).append(")\n");
        sb.append("----------------------------------------\n");
        sb.append("REQUIRED MODIFICATIONS:\n");

        if (build.getInstalledParts().isEmpty()) {
            sb.append("  • Stock factory delivery (no aftermarket parts)\n");
        } else {
            for (Part p : build.getInstalledParts()) {
                sb.append(String.format("  [ ] Part #%d: %s (+$%,.2f)\n",
                        p.getPartId(), p.getName(), p.getPriceModifier()));
            }
        }
        sb.append("----------------------------------------\n");
        sb.append(String.format("TOTAL INVOICE: $%,.2f\n", build.getTotalPrice()));
        sb.append("========================================");
        return sb.toString();
    }

    @Override
    public String toString() {
        return String.format("Ticket #%d | %s - %s [%s]",
                ticketId, build.getVehicle().getName(), customerName, status);
    }
}
